{
    "name": "haosg-group/dolibarr-strongauth",
    "description": "Strong authentication for Dolibarr: TOTP 2FA, SSO (Entra ID/Google/Apple/OIDC), optional WebAuthn Passkey",
    "type": "dolibarr-module",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-hash": "*",
        "robthree/twofactorauth": "^2.0",
        "firebase/php-jwt": "^7.0",
        "web-auth/webauthn-framework": "~4.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "classmap": [
            "class/",
            "core/"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
