('CCL', 'Childcare Leave (育儿假)', 1, 0, 0, 29, 1),
('UPL', 'Unpaid Leave (无薪假)', 0, 0, 0, 29, 1),
('CL', 'Compassionate Leave (恩恤假)', 0, 0, 0, 29, 1),
('MRL', 'Marriage Leave (婚假)', 0, 0, 0, 29, 1),
