+		// to 'YYYYMMDDHHMMSS' shape and misses every row.
+		$sql .= ' AND p.datep BETWEEN FROM_UNIXTIME('.(int) $from.') AND FROM_UNIXTIME('.(int) $to.')';
+		$sql .= ' ORDER BY ABS(p.amount - '.((float) $amount).') ASC, p.datep ASC LIMIT 5';
