+		$out = array();
+		$resql = $this->db->query($sql);
+		if ($resql) {
+			while ($obj = $this->db->fetch_object($resql)) {
+				$dp = is_numeric($obj->datep) ? (int) $obj->datep : strtotime((string) $obj->datep);
+				$out[] = array(
+					'rowid' => (int) $obj->rowid,
+					'datep' => (int) $dp,
+					'amount' => (float) $obj->amount,
+					'diff' => abs((float) $obj->amount - $amount),
+				);
+			}
+			$this->db->free($resql);
+		}
+		return $out;
+	}
