-+				if (self::dumpPath($bucket, $name) === null) {
-+					continue;
-+				}
-+				$dump = json_decode((string) @file_get_contents($path), true);
-+				if (!is_array($dump)) {
-+					continue;
-+				}
-+				if ($entity >= 1 && isset($dump['entity']) && (int) $dump['entity'] !== (int) $entity) {
-+					continue;
-+				}
