-+			return -21;
-+		}
-+		$match = $this->findInvoiceCandidates($row);
-+		if (!isset($match['mode']) || $match['mode'] !== 'so') {
-+			return -22;
-+		}
-+		if (!isset($match['invoices'][0]) || count($match['invoices']) !== 1) {
