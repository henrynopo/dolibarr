+		// The incoming row doesn't carry the body hash directly; it's on
+		// llx_slycustom_wise_event.payload_md5, linked via fk_event.
+		$payloadMd5 = '';
+		if ($fkEvent > 0) {
+			$sqlEv = 'SELECT payload_md5 FROM '.MAIN_DB_PREFIX.'slycustom_wise_event';
+			$sqlEv .= ' WHERE rowid = '.$fkEvent;
+			$resqlEv = $this->db->query($sqlEv);
+			if ($resqlEv) {
+				$evObj = $this->db->fetch_object($resqlEv);
+				if ($evObj) {
+					$payloadMd5 = (string) $evObj->payload_md5;
+				}
+				$this->db->free($resqlEv);
+			}
+		}
+
+		$sqlDel = 'DELETE FROM '.MAIN_DB_PREFIX.'slycustom_wise_incoming';
+		$sqlDel .= ' WHERE rowid = '.$rowid;
+		$sqlDel .= ' AND entity = '.$entity;
+		if (!$this->db->query($sqlDel)) {
+			return array('ok' => false, 'message' => 'row delete failed: '.$this->db->lasterror(), 'dump_deleted' => 0);
+		}
+
+		// Best-effort: clean up accepted-bucket dumps whose body md5 matches.
+		// Truncated bootstrap dumps (body_truncated=true, 2 KB head slice)
+		// naturally won't match the full payload md5, so they're left
+		// alone — they hold the IP/source-IP evidence for rejected-mode
+		// triage and are managed from dumps.php.
+		$dumpDeleted = 0;
+		if ($payloadMd5 !== '') {
+			$dir = rtrim(DOL_DATA_ROOT, '/').'/wise_webhook/accepted';
+			if (is_dir($dir)) {
+				$files = glob($dir.'/*.json');
+				if (is_array($files)) {
+					foreach ($files as $path) {
+						$name = basename($path);
+						if (self::dumpPath('accepted', $name) === null) {
+							continue;
+						}
+						$raw = (string) @file_get_contents($path);
+						if ($raw === '') {
+							continue;
+						}
+						$dump = json_decode($raw, true);
+						if (!is_array($dump) || !isset($dump['body']) || !is_string($dump['body'])) {
+							continue;
+						}
+						if (md5($dump['body']) === $payloadMd5) {
+							if (@unlink($path)) {
+								$dumpDeleted++;
+							}
+						}
+					}
+				}
+			}
+		}
+
+		return array('ok' => true, 'message' => 'deleted', 'dump_deleted' => $dumpDeleted);
+	}
 }
 }
