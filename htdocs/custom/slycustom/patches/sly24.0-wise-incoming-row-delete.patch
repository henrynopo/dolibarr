-+					'received_at' => isset($dump['received_at']) ? (int) $dump['received_at'] : 0,
-+					'remote_ip' => isset($dump['remote_ip']) ? (string) $dump['remote_ip'] : '',
-+					'bootstrap' => !empty($dump['bootstrap']),
-+					'truncated' => !empty($dump['body_truncated']),
