+	public function getCurrencyFlagEmoji($currency_code)
+	{
+		$currency_to_country = array(
+			'AED' => 'AE', 'AUD' => 'AU', 'BRL' => 'BR', 'CAD' => 'CA', 'CHF' => 'CH', 'CNY' => 'CN',
