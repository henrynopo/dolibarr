{
	"$schema": "./sftp-schema.json",
	"name": "SLY Dolibarr",
	"defaultProfile": "test",
	"context": "./custom/",
	"uploadOnSave": true,
	"watcher": {
		"files": "**/*",
		"autoUpload": true,
		"autoDelete": true
	},
	"ignore": [
		"**/documents/**",
		"**/conf/conf.php",
		"**/install/**",
		".git/**",
		".github/**",
		".vscode/**",
		".cursor/**",
		".idea/**",
		".phan/**",
		".tx/**",
		"*.log",
		"backup.sql",
		"backup-*.sql",
		"**/~$*",
		"**/*.tmp",
		".DS_Store",
		"**/sftp.json"
	],
	"concurrency": 5,
	"useTempFile": false,
	"skipNewer": false,
